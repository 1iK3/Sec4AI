{
  "version": 2,
  "rewrites": [
    {
      "source": "/prompt/([^/]+)",
      "destination": "/index.html"
    },
    {
      "source": "/raw/([^/]+)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    }
  ]
}
